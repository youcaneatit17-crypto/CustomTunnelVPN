<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E12"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP BAR BERANDA & PROFIL -->
        <LinearLayout
            android:id="@+id/topBarMain"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="#15181E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom Tunnel"
                android:textColor="#FB923C"
                android:textSize="18sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_offline"
                android:fontFamily="monospace"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="OFFLINE"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TOP BAR PENGATURAN (VPN PER APLIKASI) -->
        <LinearLayout
            android:id="@+id/topBarSettings"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="#15181E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnBackFromSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#E2E8F0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="VPN per aplikasi"
                android:textColor="#F3F4F6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearSelectedApps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="+"
                android:rotation="45"
                android:textColor="#E2E8F0"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- SUB-TABS BERANDA -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#15181E"
            app:tabIndicatorColor="#3B82F6"
            app:tabIndicatorHeight="2.5dp"
            app:tabSelectedTextColor="#3B82F6"
            app:tabTextAppearance="@android:style/TextAppearance.Small"
            app:tabTextColor="#9CA3AF">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utama" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log" />
        </com.google.android.material.tabs.TabLayout>

        <!-- CONTENT AREA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- BERANDA: UTAMA -->
            <ScrollView
                android:id="@+id/layoutUtama"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="76dp">

                    <!-- TRAFFIC CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Trafik"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="↓ Unduh"
                                    android:textColor="#4ADE80"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvStatDown"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="0 bps"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStatDownPeak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Puncak: 0 bps"
                                    android:textColor="#6B7280"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="↑ Unggah"
                                    android:textColor="#6EA8FE"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvStatUp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="0 bps"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStatUpPeak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Puncak: 0 bps"
                                    android:textColor="#6B7280"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStatusDotLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_input"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="● Tidak aktif"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvLocalIp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="192.168.42.22"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- KONEKSI UTAMA & REFRESH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSplitSummaryHome"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="VPN per aplikasi: Semua aplikasi"
                                android:textColor="#9CA3AF"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnLihatSplit"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#1F2937"
                                android:text="Atur"
                                android:textColor="#6EA8FE"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnRefresh"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#0284C7"
                            android:text="REFRESH JALUR (ANTI-LEMOT)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- KONFIGURASI SLOWDNS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="👤 SlowDNS"
                            android:textColor="#34D399"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spDnsType"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp" />

                        <EditText
                            android:id="@+id/etDns"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="DNS Resolver (1.1.1.1)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F3F4F6"
                            android:textColorHint="#6B7280"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etNs"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="NS (Nameserver)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F3F4F6"
                            android:textColorHint="#6B7280"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etPubkey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="Public Key (64-char Hex)"
                            android:minHeight="44dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:textColor="#FCD34D"
                            android:textColorHint="#6B7280"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etSessions"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="Jumlah Sesi (1 - 4)"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F3F4F6"
                            android:textColorHint="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- AKUN SSH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="🔑 Akun SSH &amp; BadVPN"
                            android:textColor="#6EA8FE"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etSshHostPort"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="Host:Port SSH (127.0.0.1:22)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F3F4F6"
                            android:textColorHint="#6B7280"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etSshUser"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input"
                                android:fontFamily="monospace"
                                android:hint="Username"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="#F3F4F6"
                                android:textColorHint="#6B7280"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/etSshPass"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input"
                                android:fontFamily="monospace"
                                android:hint="Password"
                                android:inputType="textPassword"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="#F3F4F6"
                                android:textColorHint="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etUdpgw"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:hint="BadVPN UDPGW Port (7300)"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F3F4F6"
                            android:textColorHint="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- BERANDA: LOG -->
            <LinearLayout
                android:id="@+id/layoutLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnCleanLog"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#1F2937"
                    android:text="BERSIHKAN LOG"
                    android:textColor="#E5E7EB"
                    android:textSize="12sp" />

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#D1D5DB"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>

            <!-- VIEW PROFIL -->
            <ScrollView
                android:id="@+id/layoutProfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📂 Profil"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:text="Simpan akun SlowDNS + SSH saat ini ke profil lokal."
                            android:textColor="#9CA3AF"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etNewProfileName"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input"
                                android:hint="Nama profil (misal: S1)"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="#F3F4F6"
                                android:textColorHint="#6B7280"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btnSaveProfile"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:backgroundTint="#3B82F6"
                                android:text="SIMPAN"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profilesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="EKSPOR / IMPOR CONFIG JSON"
                            android:textColor="#FBBF24"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etConfigJson"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:gravity="top|start"
                            android:hint="Tempel JSON config di sini untuk impor..."
                            android:padding="10dp"
                            android:textColor="#D1D5DB"
                            android:textColorHint="#6B7280"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnExportJson"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#1F2937"
                                android:text="SALIN CONFIG"
                                android:textColor="#E5E7EB"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnImportJson"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#059669"
                                android:text="IMPOR CONFIG"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- VIEW PENGATURAN: VPN PER APLIKASI -->
            <LinearLayout
                android:id="@+id/layoutPengaturan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ⓘ Menampilkan aplikasi terpasang untuk memilih mana yang lewat VPN. Daftarnya tetap di perangkat ini."
                    android:textColor="#9CA3AF"
                    android:textSize="11.5sp" />

                <!-- PILIH MODE (KLIK UNTUK DIALOG) -->
                <LinearLayout
                    android:id="@+id/btnSelectSplitMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode"
                        android:textColor="#F3F4F6"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSplitModeDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Semua aplikasi"
                        android:textColor="#9CA3AF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ⓘ Sambungkan ulang agar berlaku."
                    android:textColor="#9CA3AF"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvSelectedAppsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 dipilih"
                    android:textColor="#E5E7EB"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- FILTER CHIPS: APLIKASI PENGGUNA / SEMUA APLIKASI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterUserApps"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#2C3340"
                        android:text="Aplikasi pengguna"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFilterAllApps"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="#15181E"
                        android:text="Semua aplikasi"
                        android:textAllCaps="false"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- SEARCH BAR -->
                <EditText
                    android:id="@+id/etSearchApps"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="Cari aplikasi..."
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />

                <!-- LIST APLIKASI TERPASANG -->
                <ListView
                    android:id="@+id/lvInstalledApps"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="#1E222A"
                    android:dividerHeight="1dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM NAV BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#15181E"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/navBeranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pillBeranda"
                    android:layout_width="56dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_nav_pill"
                    android:gravity="center"
                    android:text="🏠"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtNavBeranda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Beranda"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pillProfil"
                    android:layout_width="56dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="📂"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtNavProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profil"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPengaturan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pillPengaturan"
                    android:layout_width="56dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtNavPengaturan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pengaturan"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FLOATING ACTION BUTTON (CONNECT) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnConnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@android:drawable/ic_media_play"
        app:backgroundTint="#1D4ED8"
        app:tint="#FFFFFF" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
