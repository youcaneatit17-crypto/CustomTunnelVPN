<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121417">

    <!-- HEADER APP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1D2025"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM "
            android:textColor="#FB923C"
            android:textSize="18sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tunnel"
            android:textColor="#F3F4F6"
            android:textSize="18sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_offline"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OFFLINE"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SUB-TABS (Utama & Log) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#1D2025"
        app:tabIndicatorColor="#6EA8FE"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="#6EA8FE"
        app:tabTextColor="#9CA3AF">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Utama" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log" />
    </com.google.android.material.tabs.TabLayout>

    <!-- VIEW BERANDA: UTAMA -->
    <ScrollView
        android:id="@+id/layoutUtama"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- KARTU STATUS & KONTROL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status Terowongan"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTunnelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Terputus (Siap)"
                            android:textColor="#E5E7EB"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveProfileBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="DNSTT + SSH"
                        android:textColor="#6EA8FE"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#2563EB"
                    android:text="HUBUNGKAN"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#0284C7"
                    android:text="REFRESH JALUR (ANTI-LEMOT)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- KARTU SLOWDNS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="KONFIGURASI SLOWDNS (DNSTT)"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDnsType"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp" />

                <EditText
                    android:id="@+id/etDns"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="DNS Resolver (1.1.1.1)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etNs"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="Nameserver (ns.domain.com)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPubkey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="Public Key (64-char Hex)"
                    android:minHeight="44dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:textColor="#FCD34D"
                    android:textColorHint="#6B7280"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etSessions"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="Jumlah Sesi (1 - 4)"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- KARTU SSH & BADVPN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="AKUN SSH-2 &amp; BADVPN"
                    android:textColor="#6EA8FE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSshHostPort"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="Host:Port SSH (127.0.0.1:22)"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etSshUser"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="Username"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#F3F4F6"
                        android:textColorHint="#6B7280"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etSshPass"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#F3F4F6"
                        android:textColorHint="#6B7280"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etUdpgw"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="BadVPN UDPGW Port (7300)"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F3F4F6"
                    android:textColorHint="#6B7280"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- VIEW BERANDA: LOG -->
    <LinearLayout
        android:id="@+id/layoutLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCleanLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#252A34"
            android:text="BERSIHKAN LOG"
            android:textColor="#E5E7EB"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="#D1D5DB"
                android:textIsSelectable="true"
                android:textSize="11.5sp" />
        </ScrollView>
    </LinearLayout>

    <!-- VIEW PROFIL (SAVE / LOAD / EXPORT / IMPORT) -->
    <ScrollView
        android:id="@+id/layoutProfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- KARTU SIMPAN PROFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profil Konfigurasi Tersimpan"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Simpan akun SlowDNS + SSH saat ini atau muat konfigurasi tersimpan."
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewProfileName"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Nama profil (misal: SG VIP)"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#F3F4F6"
                        android:textColorHint="#6B7280"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="#6EA8FE"
                        android:text="SIMPAN"
                        android:textColor="#0F172A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- DAFTAR PROFIL DINAMIS -->
            <LinearLayout
                android:id="@+id/profilesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical" />

            <!-- EKSPOR / IMPOR JSON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="EKSPOR / IMPOR KONFIGURASI JSON"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfigJson"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="Tempel JSON config di sini untuk impor..."
                    android:padding="10dp"
                    android:textColor="#D1D5DB"
                    android:textColorHint="#6B7280"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExportJson"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#252A34"
                        android:text="SALIN CONFIG"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnImportJson"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#059669"
                        android:text="IMPOR CONFIG"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION (BERANDA & PROFIL) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#1D2025"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pillBeranda"
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_nav_pill"
                android:gravity="center"
                android:text="🏠"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNavBeranda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="#E5E7EB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pillProfil"
                android:layout_width="64dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="📂"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNavProfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profil"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>