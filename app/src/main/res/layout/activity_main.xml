<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#121417">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Custom Tunnel"
        android:textColor="#FFB74D"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121417"
        app:tabTextColor="#8E9297"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabIndicatorColor="#64B5F6">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Utama" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:id="@+id/layoutUtama"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KONFIGURASI SLOWDNS"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spDnsType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E2126"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DNS Resolver (8.8.8.8, tcp://1.1.1.1, https://...)"
                android:text="1.1.1.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etNs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nameserver (NS)"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPubkey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SlowDNS Public Key (Hex)"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jumlah Sesi Paralel (1-4, default: 2)"
                android:text="2"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AKUN SSH &amp; BADVPN"
                android:textColor="#64B5F6"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etSshHostPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SSH Host:Port (contoh: 127.0.0.1:22)"
                android:text="127.0.0.1:22"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etSshUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username SSH"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etSshPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password SSH"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etUdpgw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Port BadVPN UDPGW (default: 7300)"
                android:text="7300"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="#1E2126"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="HUBUNGKAN"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="REFRESH JALUR (ANTI-LEMOT)"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutLog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCleanLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:text="CLEAN LOG"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#E0E0E0" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
